# ==============================================================================
# LinkScope — Anonymous Session BYOK Configuration (No Database)
# ==============================================================================

# Server configuration
NODE_ENV=development
PORT=4000

# ------------------------------------------------------------------------------
# Security & Master Encryption Key (MANDATORY)
# ------------------------------------------------------------------------------
# Must be a cryptographically secure 32-byte secret (64 hex characters).
# Used for AES-256-GCM encryption of in-memory session credentials at rest.
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit the actual key to source control!
GEMINI_ENCRYPTION_KEY="your_64_character_hex_encryption_key_here"

# ------------------------------------------------------------------------------
# Session Configuration
# ------------------------------------------------------------------------------
# Anonymous Session Lifetime (TTL in seconds). Default: 86400 (24 hours).
# Sessions and temporary keys are held in server memory and wiped on logout or expiration.
SESSION_KEY_TTL_SECONDS=86400

# Optional CORS / CSRF allowed origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:4000"

# ------------------------------------------------------------------------------
# Model-Independent AI Provider Configuration
# ------------------------------------------------------------------------------
# Provider identifier (currently: gemini)
AI_PROVIDER="gemini"

# Configured single primary model (e.g. "gemini-3.1-flash-lite").
AI_MODEL="gemini-3.1-flash-lite"

# NOTE:
# LinkScope is a 100% demo application.
# No Supabase, PostgreSQL, or external databases are required.
# A shared developer-owned GEMINI_API_KEY is NOT required.
